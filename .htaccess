# ShionMusicBot — OpenLiteSpeed/Apache access controls
Options -Indexes
RewriteEngine On

# Never serve dot-files, source, secrets, logs, archives or runtime artefacts.
# Keep the simple exact-prefix rules first for OpenLiteSpeed compatibility.
RewriteRule ^\. - [F,L]
RewriteRule ^requirements - [F,L,NC]
RewriteRule ^pytest\.ini$ - [F,L,NC]
RewriteRule ^(README|LICENSE)(\.|$) - [F,L,NC]
RewriteRule ^.*\.(env|log|json|py|pyc|sh|md|txt|ini|toml|ya?ml|gz|zip|tar|xz|session|tmp|part|lock|pid|bak|old|dist|whl)$ - [F,L,NC]
RewriteRule ^(anony|cache|downloads|data|venv|bin|tests|inc|docs|scripts|\.runtime|\.git)(/|$) - [R=404,L,NC]
RewriteRule ^(runner_lib\.php|session_auth\.py|bootstrap\.sh|ensure-running\.sh)$ - [F,L,NC]

<FilesMatch "\.txt$">
  Require all denied
</FilesMatch>
<FilesMatch "(^\.|^requirements|\.(env|log|json|py|pyc|sh|md|ini|toml|ya?ml|gz|zip|tar|xz|session|tmp|part|lock|pid|bak|old|dist|whl)$|^runner_lib\.php$|^session_auth\.py$)">
  Require all denied
</FilesMatch>

# OpenLiteSpeed evaluates RedirectMatch reliably for extensionless/dot files.
RedirectMatch 404 ^/.*/(requirements[^/]*|\.env[^/]*|\.git[^/]*)$

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
