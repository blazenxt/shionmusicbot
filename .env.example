# Shion Music bot configuration
# Copy this file to .env and fill your own secrets. Never commit .env.

BOT_NAME="Shion Music bot"

# Telegram API credentials from https://my.telegram.org
API_ID=123456
API_HASH="your_api_hash_here"

# Bot token from @BotFather
BOT_TOKEN="123456:ABCDEF_your_bot_token_here"

# Assistant user session string. Generate with: python scripts/generate_session.py
SESSION_STRING="your_pyrogram_session_string_here"
ASSISTANT_PHONE="+10000000000"

# Optional owner/sudo users. Telegram numeric user IDs, comma-separated.
OWNER_ID=
SUDO_USERS=

# Runtime behavior
AUTO_START_VOICE_CHAT=true
AUTO_LEAVE_WHEN_QUEUE_EMPTY=true
ADMIN_ONLY_CONTROLS=true
DEFAULT_DJ_MODE=false
MAX_DURATION_SECONDS=10800
PLAYLIST_LIMIT=20
MAX_FILE_SIZE_MB=100
LOG_LEVEL=INFO

# Optional paths
DATABASE_PATH=./shion.sqlite3
SESSIONS_DIR=./sessions
DOWNLOADS_DIR=./downloads

# Optional yt-dlp cookies for age-restricted/private videos
YTDLP_COOKIE_FILE=

# Optional external YouTube extractor endpoint, e.g. https://example.com/yt
YT_API_BASE=
