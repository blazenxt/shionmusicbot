# ShionMusicBot — environment configuration
# Copy this file to `.env` and fill in your own credentials.

# ── Telegram API (https://my.telegram.org) ───────────────────────────────
API_ID=35458756
API_HASH=eac538ffbeb1c5a039a9a9e6ff293149

# ── Bot account (from @BotFather) ────────────────────────────────────────
BOT_TOKEN=123456789:AA-your-bot-token
BOT_USERNAME=ShionMusicBot
OWNER_ID=7330774855
OWNER_USERNAME=zucms

# ── Assistant / userbot account (Pyrogram v2 session string) ─────────────
SESSION1=
SESSION_STRING=
ASSISTANT_ID=8292016026
ASSISTANT_USERNAME=ShionVCAssistant

# ── Community links ──────────────────────────────────────────────────────
SUPPORT_CHANNEL=https://t.me/zucms
SUPPORT_CHAT=https://t.me/zucms

# ── Testweb3 YouTube proxy (single-source streaming policy) ──────────────
YT_API_BASE=http://Testweb3.cstsc.in/yt/

# ── Limits & behaviour ───────────────────────────────────────────────────
DURATION_LIMIT=60        # minutes; tracks longer than this are refused
QUEUE_LIMIT=20           # max queued tracks per chat
PLAYLIST_LIMIT=20        # max playlist entries fetched at once
AUTO_LEAVE=False         # never auto-leave normal groups
AUTO_END=False           # keep the voice-chat connection idle grace period
THUMB_GEN=False          # dynamic thumbnail processing
VIDEO_PLAY=True          # allow /vplay video streaming
LANG_CODE=en             # default language (en / hi)

# ── Web dashboard runner key (runner.php access secret) ──────────────────
RUNNER_KEY=change-me-to-a-long-random-string
