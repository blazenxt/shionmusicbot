# Copy to ~/private/shionmusicbot_runtime/bot.env in production.
# Never commit the real values.

API_ID=12345678
API_HASH=replace_with_32_character_api_hash
BOT_TOKEN=123456789:replace_with_botfather_token
BOT_USERNAME=ShionMusicBot
OWNER_ID=123456789
OWNER_USERNAME=your_username

SESSION1=
SESSION_STRING=
ASSISTANT_ID=0
ASSISTANT_USERNAME=ShionVCAssistant

SUPPORT_CHANNEL=https://t.me/your_channel
SUPPORT_CHAT=https://t.me/your_chat
YT_API_BASE=https://testweb3.cstsc.in/yt/

DURATION_LIMIT=60
QUEUE_LIMIT=20
PLAYLIST_LIMIT=20
AUTO_LEAVE=False
AUTO_END=False
THUMB_GEN=False
VIDEO_PLAY=True
LANG_CODE=en

# Generate two independent random values (at least 32 bytes each).
RUNNER_KEY=replace_with_long_random_runner_key
SESSION_MANAGER_KEY=replace_with_long_random_manager_key
